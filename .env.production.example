# ========================================
# Production Environment Template
# ========================================
# Copy this file into your deployment provider's environment settings.
# All URLs below must point at the same single HTTPS production origin.

# ========================================
# Supabase Configuration
# ========================================
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# ========================================
# NextAuth Configuration
# ========================================
NEXTAUTH_SECRET=GENERATE_A_LONG_RANDOM_SECRET
NEXTAUTH_URL=https://app.example.com

# ========================================
# AI Providers Configuration
# ========================================
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

DEFAULT_MODEL=gpt-4o-mini
CHEAP_MODEL=gpt-4o-mini
PREMIUM_MODEL=gpt-4o

# ========================================
# Google OAuth / Export Configuration
# ========================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_DOCS_CREDENTIALS=

# ========================================
# Redis Configuration
# ========================================
# Production must use a TLS-enabled Redis endpoint.
REDIS_URL=rediss://username:password@host:port

# ========================================
# App Configuration
# ========================================
NEXT_PUBLIC_APP_URL=https://app.example.com
NODE_ENV=production
APP_ENV=production

# ========================================
# Monitoring Configuration (Optional)
# ========================================
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
